<Application x:Class="NetwatchPro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NetwatchPro.Converters"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:ConfidenceToBrushConverter x:Key="ConfidenceBrush"/>
            <conv:CategoryToBrushConverter x:Key="CategoryBrush"/>
            <conv:SeverityToBrushConverter x:Key="SeverityBrush"/>
            <conv:RateTextConverter x:Key="RateText"/>
            <conv:EqualsConverter x:Key="Equals"/>
            <conv:SectionBrushConverter x:Key="SectionBrush"/>
            <conv:SectionToVisibilityConverter x:Key="SectionVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
