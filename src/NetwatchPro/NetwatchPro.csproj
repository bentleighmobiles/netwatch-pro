<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NetwatchPro</RootNamespace>
    <AssemblyName>NetwatchPro</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Version>0.1.0</Version>
    <AssemblyTitle>NETWATCH PRO</AssemblyTitle>
    <Product>NETWATCH PRO</Product>
    <Description>Vendor-agnostic Windows network diagnostics &amp; monitoring console</Description>
    <Company>RYMANTECH</Company>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\ShareTechMono-Regular.ttf" />
    <Resource Include="Assets\Geo\world-110m.json" />
    <Resource Include="Assets\agent-signatures.json" />
  </ItemGroup>

</Project>
