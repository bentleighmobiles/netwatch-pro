<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:NetwatchPro.Controls">

    <!-- ============ TYPE ============ -->
    <FontFamily x:Key="FontMono">Share Tech Mono, Consolas, Cascadia Mono, Courier New</FontFamily>
    <FontFamily x:Key="FontHead">Share Tech Mono, Consolas, Segoe UI Semibold</FontFamily>

    <!-- ============ CORE SURFACES ============ -->
    <Color x:Key="BgColor">#0A0B10</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#0A0B10"/>
    <SolidColorBrush x:Key="CrtBrush" Color="#0B0D13"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#11141C"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#161A24"/>
    <SolidColorBrush x:Key="WellBrush" Color="#080A10"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#1D2430"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2A3242"/>
    <SolidColorBrush x:Key="BorderBrightBrush" Color="#3A4458"/>

    <!-- ============ AGED CHASSIS ============ -->
    <LinearGradientBrush x:Key="ChassisBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C9CED8" Offset="0.0"/>
        <GradientStop Color="#9AA0AC" Offset="0.42"/>
        <GradientStop Color="#5F6670" Offset="0.50"/>
        <GradientStop Color="#8A909B" Offset="0.62"/>
        <GradientStop Color="#B7BCC6" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ChassisDarkBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3A4048" Offset="0.0"/>
        <GradientStop Color="#23272E" Offset="0.5"/>
        <GradientStop Color="#2E333B" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- ============ TELEMETRY ACCENTS ============ -->
    <Color x:Key="CyanColor">#26D3E8</Color>
    <SolidColorBrush x:Key="CyanBrush" Color="#26D3E8"/>
    <Color x:Key="PhosphorColor">#5CFF6A</Color>
    <SolidColorBrush x:Key="PhosphorBrush" Color="#5CFF6A"/>
    <Color x:Key="AmberColor">#FFB000</Color>
    <SolidColorBrush x:Key="AmberBrush" Color="#FFB000"/>
    <Color x:Key="OrangeColor">#FF8C2E</Color>
    <SolidColorBrush x:Key="OrangeBrush" Color="#FF8C2E"/>
    <Color x:Key="VioletColor">#A78BFA</Color>
    <SolidColorBrush x:Key="VioletBrush" Color="#A78BFA"/>
    <Color x:Key="RedColor">#FF3B4E</Color>
    <SolidColorBrush x:Key="RedBrush" Color="#FF3B4E"/>
    <Color x:Key="GreyColor">#6B7A8F</Color>
    <SolidColorBrush x:Key="GreyBrush" Color="#6B7A8F"/>

    <!-- ============ TEXT ============ -->
    <SolidColorBrush x:Key="TextBrush" Color="#D8DFEA"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#8A95A7"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#4A5466"/>

    <!-- ============ CRT SCANLINE OVERLAY ============ -->
    <DrawingBrush x:Key="ScanlineBrush" TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#00000000">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,4,2"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="ScanlineDarkBrush" TileMode="Tile" Viewport="0,0,3,3" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#AA000000">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,3,1"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ============ GLOWS ============ -->
    <DropShadowEffect x:Key="GlowCyan" Color="#26D3E8" BlurRadius="10" ShadowDepth="0" Opacity="0.75"/>
    <DropShadowEffect x:Key="GlowPhosphor" Color="#5CFF6A" BlurRadius="10" ShadowDepth="0" Opacity="0.75"/>
    <DropShadowEffect x:Key="GlowAmber" Color="#FFB000" BlurRadius="10" ShadowDepth="0" Opacity="0.75"/>
    <DropShadowEffect x:Key="GlowRed" Color="#FF3B4E" BlurRadius="10" ShadowDepth="0" Opacity="0.75"/>
    <DropShadowEffect x:Key="GlowViolet" Color="#A78BFA" BlurRadius="10" ShadowDepth="0" Opacity="0.75"/>

    <!-- ============ BASE TEXT STYLES ============ -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontHead}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontHead}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style x:Key="Faint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
    </Style>

    <!-- ============ PANEL FRAME (metallic bezel + CRT well) ============ -->
    <Style x:Key="PanelFrame" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ChassisDarkBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ChassisBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="PanelWell" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CrtBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="6"/>
    </Style>

    <!-- ============ BUTTON (nav / tactile) ============ -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontHead}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1E2733"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#16202B"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ DATA GRID ============ -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource WellBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="#0E1119"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLineBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#141924"/>
        <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontHead}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#142A3A"/>
                <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#121A28"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- ============ SCROLLBAR ============ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="#0A0C12"/>
        <Setter Property="Width" Value="10"/>
    </Style>

    <!-- ============ TOOLTIP ============ -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#161B26"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrightBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Padding" Value="6,3"/>
    </Style>

    <!-- ============ CHECKBOX / RADIO (settings) ============ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- ============ RADIO (settings) ============ -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="dot" Width="8" Height="8" Fill="#2A3242"
                                 Stroke="#3A4458" StrokeThickness="1"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource CyanBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="dot" Property="Stroke" Value="{StaticResource CyanBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ TAB CONTROL (dark) ============ -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontHead}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="10,4" CornerRadius="3,3,0,0" Margin="0,0,2,0">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#141924"/>
                            <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1E2733"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ PANEL FRAME (instrument chrome) ============ -->
    <Style TargetType="{x:Type controls:PanelFrame}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PanelFrame}">
                    <Border Background="{StaticResource ChassisDarkBrush}"
                            BorderBrush="{StaticResource ChassisBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="3"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="2,0,2,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <controls:LedIndicator Grid.Column="0" Width="7" Height="7"
                                                       VerticalAlignment="Center" Margin="0,0,5,0"
                                                       IsOn="True" Color="{TemplateBinding Accent}"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Header}"
                                           FontFamily="{StaticResource FontHead}" FontSize="11"
                                           FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="2" Content="{TemplateBinding HeaderRight}"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                            <Border Grid.Row="1" Background="{StaticResource CrtBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2">
                                <Grid>
                                    <ContentPresenter Content="{TemplateBinding Content}"/>
                                    <Rectangle IsHitTestVisible="False" Fill="{StaticResource ScanlineBrush}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
