<UserControl x:Class="NetwatchPro.Views.DriverStackPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NetwatchPro.Controls">
    <controls:PanelFrame Header="FILTER / DRIVER STACK" Accent="#A78BFA">
        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#0E1119" BorderBrush="#2A3242" BorderThickness="1" Padding="6,4" Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="CONCEPTUAL PROCESSING PATH — SELECTED CONNECTION"/>
                    <TextBlock Style="{StaticResource Faint}" Text="Observed/inferred path, not a universal fixed sequence." Margin="0,1,0,3"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition Height="Auto"/><RowDefinition/>
                            <RowDefinition Height="Auto"/><RowDefinition/>
                            <RowDefinition Height="Auto"/><RowDefinition/>
                            <RowDefinition Height="Auto"/><RowDefinition/>
                            <RowDefinition Height="Auto"/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource Value}" Text="APPLICATION" FontSize="9" Foreground="#5CFF6A"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Value}" FontSize="9" Text="{Binding SelectedFlow.ProcessName}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="▼" Foreground="#4A5466" FontSize="8" HorizontalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Style="{StaticResource Value}" Text="WINDOWS NETWORKING APIs" FontSize="9" Foreground="#26D3E8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" FontSize="9" Text="WinSock → WFP engine" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="▼" Foreground="#4A5466" FontSize="8" HorizontalAlignment="Center"/>

                        <TextBlock Grid.Row="4" Style="{StaticResource Value}" Text="WFP FILTERING LAYER" FontSize="9" Foreground="#FF8C2E"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" FontSize="9" Text="{Binding SelectedFlow.WfpLayer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="▼" Foreground="#4A5466" FontSize="8" HorizontalAlignment="Center"/>

                        <TextBlock Grid.Row="6" Style="{StaticResource Value}" Text="NDIS / FILTER DRIVERS" FontSize="9" Foreground="#FFB000"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Value}" FontSize="9" Text="{Binding SelectedFlow.Driver}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="▼" Foreground="#4A5466" FontSize="8" HorizontalAlignment="Center"/>

                        <TextBlock Grid.Row="8" Style="{StaticResource Value}" Text="VIRTUAL / PHYSICAL ADAPTER" FontSize="9" Foreground="#A78BFA"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource Value}" FontSize="9" Text="{Binding SelectedFlow.InterfaceName}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="9" Grid.ColumnSpan="2" Text="▼" Foreground="#4A5466" FontSize="8" HorizontalAlignment="Center"/>

                        <TextBlock Grid.Row="10" Style="{StaticResource Value}" Text="DESTINATION" FontSize="9" Foreground="#FF3B4E"/>
                        <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource Value}" FontSize="9" Text="{Binding SelectedFlow.DestinationHost}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Components}" SelectedItem="{Binding SelectedComponent, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="STAGE" Binding="{Binding TypeLabel}" Width="120"/>
                    <DataGridTextColumn Header="COMPONENT" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="PROVIDER" Binding="{Binding Vendor}" Width="90"/>
                    <DataGridTextColumn Header="DRIVER" Binding="{Binding Driver}" Width="120"/>
                    <DataGridTextColumn Header="VERSION" Binding="{Binding Version}" Width="90"/>
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="70"/>
                    <DataGridTextColumn Header="CONFIDENCE" Binding="{Binding ConfidenceLabel}" Width="95">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Confidence, Converter={StaticResource ConfidenceBrush}}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </controls:PanelFrame>
</UserControl>
