<UserControl x:Class="NetwatchPro.Views.DriversDestinationsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NetwatchPro.Controls">
    <controls:PanelFrame Header="DRIVERS &amp; DESTINATIONS" Accent="#FFB000">
        <TabControl Margin="2">
            <TabItem Header="DRIVERS">
                <DataGrid ItemsSource="{Binding Components}" SelectedItem="{Binding SelectedComponent, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="COMPONENT" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="VENDOR" Binding="{Binding Vendor}" Width="90"/>
                        <DataGridTextColumn Header="TYPE" Binding="{Binding TypeLabel}" Width="110"/>
                        <DataGridTextColumn Header="DRIVER" Binding="{Binding Driver}" Width="120"/>
                        <DataGridTextColumn Header="SERVICE" Binding="{Binding Service}" Width="90"/>
                        <DataGridTextColumn Header="VERSION" Binding="{Binding Version}" Width="90"/>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="70"/>
                        <DataGridTextColumn Header="CONFIDENCE" Binding="{Binding ConfidenceLabel}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding Confidence, Converter={StaticResource ConfidenceBrush}}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="DESTINATIONS">
                <DataGrid ItemsSource="{Binding Flows}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="HOST" Binding="{Binding DestinationHost}" Width="*"/>
                        <DataGridTextColumn Header="IP" Binding="{Binding DestinationIp}" Width="110"/>
                        <DataGridTextColumn Header="PORT" Binding="{Binding Port}" Width="50"/>
                        <DataGridTextColumn Header="PROTO" Binding="{Binding Protocol}" Width="50"/>
                        <DataGridTextColumn Header="PROCESS" Binding="{Binding ProcessName}" Width="100"/>
                        <DataGridTextColumn Header="ROUTE" Binding="{Binding Route}" Width="70"/>
                        <DataGridTextColumn Header="COMPONENT" Binding="{Binding Component}" Width="110"/>
                        <DataGridTextColumn Header="CONFIDENCE" Binding="{Binding ConfidenceLabel}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding Confidence, Converter={StaticResource ConfidenceBrush}}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="APPLICATIONS">
                <DataGrid ItemsSource="{Binding Flows}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PROCESS" Binding="{Binding ProcessName}" Width="*"/>
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60"/>
                        <DataGridTextColumn Header="REMOTE" Binding="{Binding DestinationHost}" Width="160"/>
                        <DataGridTextColumn Header="DOWN" Binding="{Binding RxRate, Converter={StaticResource RateText}}" Width="90"/>
                        <DataGridTextColumn Header="UP" Binding="{Binding TxRate, Converter={StaticResource RateText}}" Width="90"/>
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding CategoryLabel}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </controls:PanelFrame>
</UserControl>
