<UserControl x:Class="NetwatchPro.Views.FlowAttributionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NetwatchPro.Controls">
    <controls:PanelFrame Header="FLOW ATTRIBUTION" Accent="#26D3E8">
        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid ItemsSource="{Binding Flows}" SelectedItem="{Binding SelectedFlow, Mode=TwoWay}" Grid.Row="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PROCESS" Binding="{Binding ProcessName}" Width="100"/>
                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="50"/>
                    <DataGridTextColumn Header="DESTINATION" Binding="{Binding DestinationHost}" Width="150"/>
                    <DataGridTextColumn Header="PROTO" Binding="{Binding Protocol}" Width="50"/>
                    <DataGridTextColumn Header="PORT" Binding="{Binding Port}" Width="50"/>
                    <DataGridTextColumn Header="INTERFACE" Binding="{Binding InterfaceName}" Width="120"/>
                    <DataGridTextColumn Header="ROUTE" Binding="{Binding Route}" Width="70"/>
                    <DataGridTextColumn Header="COMPONENT" Binding="{Binding Component}" Width="110"/>
                    <DataGridTextColumn Header="WFP LAYER" Binding="{Binding WfpLayer}" Width="140"/>
                    <DataGridTextColumn Header="DRIVER" Binding="{Binding Driver}" Width="110"/>
                    <DataGridTextColumn Header="DOWN" Binding="{Binding RxRate, Converter={StaticResource RateText}}" Width="85"/>
                    <DataGridTextColumn Header="UP" Binding="{Binding TxRate, Converter={StaticResource RateText}}" Width="85"/>
                    <DataGridTextColumn Header="CONFIDENCE" Binding="{Binding ConfidenceLabel}" Width="95">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Confidence, Converter={StaticResource ConfidenceBrush}}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1" Background="#0E1119" BorderBrush="#2A3242" BorderThickness="1" Margin="0,4,0,0" Padding="6,3">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="PATH INSPECTOR — SELECTED CONNECTION"/>
                    <TextBlock Style="{StaticResource Value}" FontSize="10">
                        <Run Text="{Binding SelectedFlow.ProcessName, Mode=OneWay}"/><Run Text="  →  "/>
                        <Run Text="{Binding SelectedFlow.DestinationHost, Mode=OneWay}"/>
                        <Run Text="  ["/><Run Text="{Binding SelectedFlow.ConfidenceLabel, Mode=OneWay}" Foreground="#FFB000"/><Run Text="]"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Faint}" Text="Attribution is evidence-based. CONFIRMED = observed; INFERRED = correlated; UNKNOWN = insufficient evidence." TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </controls:PanelFrame>
</UserControl>
