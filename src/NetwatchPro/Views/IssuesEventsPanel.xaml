<UserControl x:Class="NetwatchPro.Views.IssuesEventsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NetwatchPro.Controls">
    <controls:PanelFrame Header="ISSUES &amp; EVENTS" Accent="#FF3B4E">
        <controls:PanelFrame.HeaderRight>
            <StackPanel Orientation="Horizontal">
                <controls:LedIndicator Width="9" Height="9" IsOn="{Binding AlertActive}" Color="#FF3B4E" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource Value}" Text="{Binding AlertCount, StringFormat=ALERTS {0}}" Foreground="#FF3B4E" Margin="4,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </controls:PanelFrame.HeaderRight>

        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent, Mode=TwoWay}" Grid.Row="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TIME" Binding="{Binding TimestampText}" Width="70"/>
                    <DataGridTextColumn Header="SEV" Binding="{Binding SeverityLabel}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="80"/>
                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="PROCESS" Binding="{Binding RelatedProcess}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1" Background="#0E1119" BorderBrush="#2A3242" BorderThickness="1" Margin="0,4,0,0" Padding="6,3">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="DETAIL"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding SelectedEvent.Description}" TextWrapping="Wrap" FontSize="10"/>
                    <TextBlock Style="{StaticResource Faint}" Text="{Binding SelectedEvent.RelatedEntity}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </controls:PanelFrame>
</UserControl>
