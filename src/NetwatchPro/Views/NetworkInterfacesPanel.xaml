<UserControl x:Class="NetwatchPro.Views.NetworkInterfacesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NetwatchPro.Controls">
    <controls:PanelFrame Header="NETWORK INTERFACES" Accent="#5CFF6A">
        <DataGrid ItemsSource="{Binding Interfaces}" Margin="4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="130"/>
                <DataGridTextColumn Header="TYPE" Binding="{Binding TypeLabel}" Width="80"/>
                <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="130"/>
                <DataGridTextColumn Header="IPV4" Binding="{Binding IPv4}" Width="110"/>
                <DataGridTextColumn Header="GATEWAY" Binding="{Binding Gateway}" Width="100"/>
                <DataGridTextColumn Header="DNS" Binding="{Binding DnsServers}" Width="140"/>
                <DataGridTextColumn Header="LINK" Binding="{Binding LinkSpeedMbps, StringFormat={}{0:F0} Mbps}" Width="80"/>
                <DataGridTextColumn Header="THROUGHPUT" Binding="{Binding ThroughputText}" Width="180"/>
                <DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="90"/>
                <DataGridTextColumn Header="CONFIDENCE" Binding="{Binding ConfidenceLabel}" Width="95">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding Confidence, Converter={StaticResource ConfidenceBrush}}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </controls:PanelFrame>
</UserControl>
