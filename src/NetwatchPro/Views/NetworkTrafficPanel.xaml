<UserControl x:Class="NetwatchPro.Views.NetworkTrafficPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NetwatchPro.Controls">
    <controls:PanelFrame Header="NETWORK TRAFFIC" Accent="#26D3E8">
        <controls:PanelFrame.HeaderRight>
            <StackPanel Orientation="Horizontal">
                <controls:ToggleSwitch Width="26" Height="14" IsChecked="{Binding ShowPrivate}" Accent="#A78BFA" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource Faint}" Text="PRV" Margin="3,0,8,0" VerticalAlignment="Center"/>
                <controls:ToggleSwitch Width="26" Height="14" IsChecked="{Binding ShowProxy}" Accent="#FFB000" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource Faint}" Text="PRX" Margin="3,0,8,0" VerticalAlignment="Center"/>
                <controls:ToggleSwitch Width="26" Height="14" IsChecked="{Binding ShowDirect}" Accent="#26D3E8" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource Faint}" Text="DIR" Margin="3,0,8,0" VerticalAlignment="Center"/>
                <controls:ToggleSwitch Width="26" Height="14" IsChecked="{Binding ShowOther}" Accent="#6B7A8F" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource Faint}" Text="OTH" Margin="3,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </controls:PanelFrame.HeaderRight>

        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="IN"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding IncomingText}" Foreground="#5CFF6A"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource Label}" Text="OUT"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding OutgoingText}" Foreground="#FFB000"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Label}" Text="TOTAL"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding TotalText}"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Style="{StaticResource Label}" Text="PEAK"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding PeakText}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Style="{StaticResource Label}" Text="AVG"/>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding AvgText}"/>
                </StackPanel>
            </Grid>

            <controls:TrendChart Grid.Row="1" Margin="0,6,0,0"
                                 ItemsSource="{Binding TrafficHistory}"
                                 ShowPrivate="{Binding ShowPrivate}"
                                 ShowProxy="{Binding ShowProxy}"
                                 ShowDirect="{Binding ShowDirect}"
                                 ShowOther="{Binding ShowOther}"
                                 WindowSeconds="{Binding TimeRangeSeconds}"/>
        </Grid>
    </controls:PanelFrame>
</UserControl>
