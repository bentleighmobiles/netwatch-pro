<UserControl x:Class="NetwatchPro.Views.SystemOverviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NetwatchPro.Controls">
    <controls:PanelFrame Header="SYSTEM OVERVIEW" Accent="#26D3E8">
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <!-- left: gauges -->
            <StackPanel Grid.Column="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <controls:AnalogGauge Width="92" Height="80" Value="{Binding CpuUsage}" Minimum="0" Maximum="100" Title="CPU" Unit="%" Accent="#26D3E8"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Style="{StaticResource Label}" Text="CPU TEMP"/>
                        <TextBlock Style="{StaticResource Value}" Text="{Binding CpuTempText}" FontSize="15"/>
                        <TextBlock Style="{StaticResource Faint}" Text="PACKAGE"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="RAM" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                        <controls:BarMeter Height="10" Value="{Binding RamUsage}" Minimum="0" Maximum="100" Segments="18"/>
                        <TextBlock Style="{StaticResource Value}" Text="{Binding RamText}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="DISK" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                        <controls:BarMeter Height="10" Value="{Binding DiskUsage}" Minimum="0" Maximum="100" Segments="18"/>
                        <TextBlock Style="{StaticResource Value}" Text="{Binding DiskText}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- right: details -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    <RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource Label}" Text="UPTIME"/>
                <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Uptime}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="COMPUTER"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding ComputerName}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="OS"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding WinVersion}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="BUILD"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding WinBuild}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="ARCH"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Architecture}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="USER"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding UserName}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="ADAPTER"/>
                <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding ActiveAdapter}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="7" Style="{StaticResource Label}" Text="REGION"/>
                <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding RegionTimeZone}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="8" Style="{StaticResource Label}" Text="NET RX"/>
                <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding NetRxText}" HorizontalAlignment="Right" Foreground="#5CFF6A"/>
                <TextBlock Grid.Row="9" Style="{StaticResource Label}" Text="NET TX"/>
                <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding NetTxText}" HorizontalAlignment="Right" Foreground="#FFB000"/>
                <TextBlock Grid.Row="10" Style="{StaticResource Faint}" Text="{Binding SourceLabel}" Foreground="#FF8C2E"/>
                <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource Faint}" Text="TELEMETRY" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </controls:PanelFrame>
</UserControl>
