<UserControl x:Class="NetwatchPro.Views.WorldMapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NetwatchPro.Controls">
    <controls:PanelFrame Header="GLOBAL NETWORK" Accent="#A78BFA">
        <Grid Margin="4">
            <controls:WorldMap ItemsSource="{Binding Flows}" Zoom="{Binding ZoomLevel}"/>
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#B010141C"
                    BorderBrush="#3A4458" BorderThickness="1" CornerRadius="2" Padding="5,3" Margin="4">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#A78BFA" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Faint}" Text="PRIVATE/TUNNEL" Margin="3,0,10,0" VerticalAlignment="Center"/>
                    <Ellipse Width="8" Height="8" Fill="#FFB000" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Faint}" Text="PROXY/SWG" Margin="3,0,10,0" VerticalAlignment="Center"/>
                    <Ellipse Width="8" Height="8" Fill="#26D3E8" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Faint}" Text="DIRECT" Margin="3,0,10,0" VerticalAlignment="Center"/>
                    <Ellipse Width="8" Height="8" Fill="#5CFF6A" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Faint}" Text="LOCAL" Margin="3,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </controls:PanelFrame>
</UserControl>
